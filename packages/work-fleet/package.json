{
	"name": "@shivaedev/work-fleet",
	"version": "0.32.3",
	"description": "Optional Board-backed execution, review and authorized delivery",
	"homepage": "https://github.com/ShivaeDev/work-apps/tree/main/packages/work-fleet#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/work-apps/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/work-apps.git",
		"directory": "packages/work-fleet"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"work-fleet": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/sql-pg": "catalog:",
		"@shivaedev/changes": "catalog:",
		"@shivaedev/contract": "catalog:",
		"@shivaedev/errors": "catalog:",
		"@shivaedev/github": "catalog:",
		"@shivaedev/http": "catalog:",
		"@shivaedev/pr-watch": "catalog:",
		"@shivaedev/reconciler": "catalog:",
		"@shivaedev/server": "catalog:",
		"@shivaedev/service": "catalog:",
		"@shivaedev/sql": "catalog:",
		"@shivaedev/work-board": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/quality": "catalog:",
		"@shivaedev/test": "catalog:",
		"@shivaedev/test-sql": "catalog:",
		"@shivaedev/test-story": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"@zip.js/zip.js": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:compiler-api",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
